{
  "name": "open-feature-poc",
  "version": "1.0.0",
  "description": "OpenFeature Enterprise Proof-of-Concept monorepo",
  "private": true,
  "workspaces": [
    "api",
    "admin-webapp",
    "webapp-bff",
    "feature-gateway",
    "webapp"
  ],
  "scripts": {
    "dev:api": "npm --workspace=api run dev",
    "dev:admin": "npm --workspace=admin-webapp run dev",
    "dev:bff": "npm --workspace=webapp-bff run dev",
    "dev:gateway": "npm --workspace=feature-gateway run dev",
    "dev:webapp": "npm --workspace=webapp run dev",
    "dev": "concurrently -n \"api,admin,bff,gw,web\" -c \"blue,green,yellow,cyan,magenta\" \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:bff\" \"npm run dev:gateway\" \"npm run dev:webapp\"",
    "test": "npm --workspace=api test && npm --workspace=webapp-bff test && npm --workspace=feature-gateway test",
    "build": "npm run build --workspaces --if-present",
    "android:build": "cd android-app && ./gradlew assembleDebug",
    "android:install": "cd android-app && ./gradlew installDebug",
    "android:start": "$HOME/Library/Android/sdk/platform-tools/adb shell am start -n com.apex.banking/.MainActivity",
    "android:emulator": "$HOME/Library/Android/sdk/emulator/emulator -avd Medium_Phone_API_36.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
